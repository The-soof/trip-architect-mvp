APP_ENV=development
JWT_SECRET_KEY=change-me-to-a-long-random-string

# Database — SQLite for local dev, PostgreSQL for Railway/production
# WARNING: SQLite data is wiped on container restart. Use PostgreSQL in production.
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/trip_architect
DATABASE_URL=sqlite:///./backend/trip_architect.db

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AI planner layer
ENABLE_REAL_AGENT=false
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=
TAVILY_API_KEY=
GOOGLE_PLACES_API_KEY=

# Travel-journey data layer (all optional — feature falls back to the generator if blank)
# SerpApi Google Flights = accurate flight times/stops/price. Get a key at serpapi.com.
SERPAPI_API_KEY=
# Travelpayouts = affiliate flight deep links (free). Token + marker from travelpayouts.com.
TRAVELPAYOUTS_TOKEN=
TRAVELPAYOUTS_MARKER=
# Safety cap so the SerpApi free tier (100 searches/mo) is never exceeded in dev.
SERPAPI_MONTHLY_CAP=90

# Fast MVP mode — caps Tavily queries to reduce latency and API cost
FAST_MVP_MODE=true
FAST_MVP_SEARCH_LIMIT=3
